{
  "name": "controle-servico-cbm",
  "version": "1.0.0",
  "description": "Sistema Digital do Livro de Registro de Atividades do Corpo de Bombeiros da PMESP",
  "main": "Code.js",
  "scripts": {
    "start": "node dev_server.js",
    "test": "node --test tests/*.test.js",
    "push": "cmd.exe /c npx.cmd @google/clasp push --force",
    "deploy": "cmd.exe /c npx.cmd @google/clasp deploy -i AKfycbxfe4LMj7D2R2sXP6FddN993eOCtGWVsVWe2YOjBQkEc-aGWhKeL5tzjavPWPM6GHiH -d AutoDeploy",
    "open": "cmd.exe /c npx.cmd @google/clasp open",
    "clasp:status": "cmd.exe /c npx.cmd @google/clasp status",
    "clasp:push": "cmd.exe /c npx.cmd @google/clasp push --force",
    "clasp:pull": "cmd.exe /c npx.cmd @google/clasp pull",
    "clasp:deploy": "cmd.exe /c npx.cmd @google/clasp deploy -i AKfycbxfe4LMj7D2R2sXP6FddN993eOCtGWVsVWe2YOjBQkEc-aGWhKeL5tzjavPWPM6GHiH -d AutoDeploy",
    "clasp:deployments": "cmd.exe /c npx.cmd @google/clasp deployments",
    "clasp:open": "cmd.exe /c npx.cmd @google/clasp open",
    "clasp:open:webapp": "cmd.exe /c npx.cmd @google/clasp open --webapp",
    "clasp:logs": "cmd.exe /c npx.cmd @google/clasp logs",
    "clasp:ship": "cmd.exe /c npx.cmd @google/clasp push --force && npx.cmd @google/clasp deploy -i AKfycbxfe4LMj7D2R2sXP6FddN993eOCtGWVsVWe2YOjBQkEc-aGWhKeL5tzjavPWPM6GHiH -d AutoDeploy"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  },
  "keywords": [
    "google-apps-script",
    "sheets",
    "pmesp",
    "cbm",
    "registro-atividades",
    "bombeiros"
  ],
  "author": "Corpo de Bombeiros - PMESP",
  "license": "UNLICENSED"
}
